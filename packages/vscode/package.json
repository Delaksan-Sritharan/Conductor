{
  "name": "conductor-vscode",
  "displayName": "Conductor – Service Orchestrator",
  "description": "Start your dev services in dependency order, each one only once the previous is actually ready.",
  "version": "0.1.1",
  "publisher": "delaksan-sritharan",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Debuggers"
  ],
  "keywords": [
    "services",
    "orchestration",
    "dev environment",
    "microservices",
    "monorepo",
    "startup order",
    "health check",
    "docker compose alternative",
    "run all",
    "multi service"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:.conductor/config.yaml",
    "workspaceContains:.conductor/config.yml"
  ],
  "contributes": {
    "commands": [
      {
        "command": "conductor.startAll",
        "title": "Start All",
        "category": "Conductor",
        "icon": "$(play)"
      },
      {
        "command": "conductor.stopAll",
        "title": "Stop All",
        "category": "Conductor",
        "icon": "$(debug-stop)"
      },
      {
        "command": "conductor.restartAll",
        "title": "Restart All",
        "category": "Conductor",
        "icon": "$(debug-restart)"
      },
      {
        "command": "conductor.startService",
        "title": "Start Service (with dependencies)",
        "category": "Conductor",
        "icon": "$(play)"
      },
      {
        "command": "conductor.stopService",
        "title": "Stop Service (and dependents)",
        "category": "Conductor",
        "icon": "$(debug-stop)"
      },
      {
        "command": "conductor.restartService",
        "title": "Restart Service",
        "category": "Conductor",
        "icon": "$(debug-restart)"
      },
      {
        "command": "conductor.showLogs",
        "title": "Show Service Logs",
        "category": "Conductor",
        "icon": "$(terminal)"
      },
      {
        "command": "conductor.doctor",
        "title": "Doctor (check environment)",
        "category": "Conductor",
        "icon": "$(checklist)"
      },
      {
        "command": "conductor.openConfig",
        "title": "Open Config",
        "category": "Conductor",
        "icon": "$(gear)"
      },
      {
        "command": "conductor.init",
        "title": "Create Config",
        "category": "Conductor"
      },
      {
        "command": "conductor.refresh",
        "title": "Reload Config",
        "category": "Conductor",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "conductor",
          "title": "Conductor",
          "icon": "media/conductor.svg"
        }
      ]
    },
    "views": {
      "conductor": [
        {
          "id": "conductor.services",
          "name": "Services"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "conductor.services",
        "contents": "No Conductor config found in this workspace.\n[Create Config](command:conductor.init)\nDescribe your services once in `.conductor/config.yaml`, then start them all in the right order with one click.",
        "when": "!conductor.hasConfig"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "conductor.startAll",
          "when": "view == conductor.services && conductor.hasConfig && !conductor.active",
          "group": "navigation@1"
        },
        {
          "command": "conductor.stopAll",
          "when": "view == conductor.services && conductor.hasConfig && conductor.active",
          "group": "navigation@1"
        },
        {
          "command": "conductor.restartAll",
          "when": "view == conductor.services && conductor.hasConfig && conductor.active",
          "group": "navigation@2"
        },
        {
          "command": "conductor.doctor",
          "when": "view == conductor.services && conductor.hasConfig",
          "group": "navigation@3"
        },
        {
          "command": "conductor.openConfig",
          "when": "view == conductor.services && conductor.hasConfig",
          "group": "navigation@4"
        },
        {
          "command": "conductor.refresh",
          "when": "view == conductor.services",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "conductor.showLogs",
          "when": "view == conductor.services && viewItem =~ /^service\\./",
          "group": "inline@1"
        },
        {
          "command": "conductor.startService",
          "when": "view == conductor.services && viewItem == service.inactive",
          "group": "inline@2"
        },
        {
          "command": "conductor.restartService",
          "when": "view == conductor.services && viewItem == service.active",
          "group": "inline@2"
        },
        {
          "command": "conductor.stopService",
          "when": "view == conductor.services && viewItem == service.active",
          "group": "inline@3"
        },
        {
          "command": "conductor.startService",
          "when": "view == conductor.services && viewItem == service.inactive",
          "group": "1_run@1"
        },
        {
          "command": "conductor.restartService",
          "when": "view == conductor.services && viewItem == service.active",
          "group": "1_run@1"
        },
        {
          "command": "conductor.stopService",
          "when": "view == conductor.services && viewItem == service.active",
          "group": "1_run@2"
        },
        {
          "command": "conductor.showLogs",
          "when": "view == conductor.services && viewItem =~ /^service\\./",
          "group": "2_view@1"
        }
      ]
    },
    "yamlValidation": [
      {
        "fileMatch": [
          ".conductor/config.yaml",
          ".conductor/config.yml"
        ],
        "url": "./schema/conductor.schema.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build -w @conductor/core --prefix ../.. && npm run build",
    "build": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js --sourcemap --minify",
    "package": "vsce package --no-dependencies -o conductor.vsix"
  },
  "dependencies": {
    "@conductor/core": "*"
  },
  "devDependencies": {
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^4.0.0"
  },
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e1e2e",
    "theme": "dark"
  },
  "homepage": "https://github.com/Delaksan-Sritharan/Conductor#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Delaksan-Sritharan/Conductor.git"
  },
  "bugs": {
    "url": "https://github.com/Delaksan-Sritharan/Conductor/issues"
  }
}
